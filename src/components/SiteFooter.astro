---
import { company, community, officialChannels, footer } from '../data/content';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer" transition:name="site-footer" transition:animate="none">
  <div class="container">
    <div class="footer-brand">
      <strong>{company.englishName}</strong>
      <p>{company.name} · {company.positioning}</p>
    </div>
    <nav class="footer-directory" aria-label="页脚导航">
      <section>
        <h2>产品与方案</h2>
        <ul>
          <li><a href={withBase('/products/')}>产品与平台</a></li>
          <li><a href={withBase('/industries/')}>行业方案</a></li>
          <li><a href={withBase('/industries/#cases')}>客户案例与项目成果</a></li>
          <li><a href={withBase('/architecture/')}>技术架构</a></li>
        </ul>
      </section>
      <section>
        <h2>资料与社区</h2>
        <ul>
          <li><a href={withBase('/resources/#product-materials')}>产品资料</a></li>
          <li><a href={withBase('/resources/#docs')}>技术文档</a></li>
          <li><a href={withBase('/resources/#videos')}>视频演示</a></li>
          <li><a href={withBase('/resources/#faq')}>常见问题</a></li>
          <li><a href={withBase('/resources/#support')}>技术支持</a></li>
          <li><a href={withBase('/community/')}>{community.name} 开源社区</a></li>
        </ul>
      </section>
      <section>
        <h2>联系与关注</h2>
        <a href={withBase('/about/#contact')}>联系我们</a>
        <p>需要补充更多内容：{footer.contactNeeded}。</p>
        <ul>
          {officialChannels.map((channel) => (
            <li>
              <a href={withBase(`/about/#${channel.id}`)}>{channel.title}</a>
              <p>需要补充更多内容：{channel.needed}。</p>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h2>公司信息</h2>
        <ul>
          <li><a href={withBase('/about/')}>公司介绍</a></li>
          <li><a href={withBase('/about/#news')}>公司动态</a></li>
          <li><a href={withBase('/about/#careers')}>加入我们</a></li>
          <li><a href={withBase('/about/#partners')}>合作伙伴</a></li>
          <li><a href={withBase('/about/#qualifications')}>资质信息</a></li>
        </ul>
      </section>
    </nav>
    <div class="footer-legal">
      <p>© {year} {company.name}</p>
      <dl>
        {footer.legal.map((item) => <div><dt>{item.title}</dt><dd>需要补充更多内容：{item.needed}。</dd></div>)}
      </dl>
    </div>
  </div>
</footer>

<style>
  .footer-brand { margin-bottom: 1.5rem; }
  .site-footer .footer-directory { display: grid; grid-template-columns: 1fr 1fr 1.35fr 1fr; gap: 2rem; align-items: start; }
  .footer-directory section { min-width: 0; overflow-wrap: anywhere; }
  .footer-directory h2 { margin-bottom: .5rem; font-size: 1rem; font-weight: 600; letter-spacing: normal; }
  .footer-directory ul { margin: 0; padding: 0; list-style: none; }
  .footer-directory a { display: flex; align-items: center; min-height: 44px; }
  .footer-directory p { margin-top: 0; }
  .footer-directory p + ul { margin-top: .5rem; }
  .footer-legal { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
  .footer-legal dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin: 1rem 0 0; font-size: .875rem; }
  .footer-legal dt { color: var(--color-blue); }
  .footer-legal dd { margin: .35rem 0 0; color: var(--color-muted); }
  @media (max-width: 900px) {
    .site-footer .footer-directory { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-legal dl { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .site-footer .footer-directory { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
