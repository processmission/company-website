---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, description, image, imageAlt = '' } = Astro.props;
---

<header class="page-heading">
  <div class:list={['container', { 'heading-illustrated': image }]}>
    {image ? (
      <>
        <div class="heading-copy">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1>{title}</h1>
          <slot name="description"><p class="section-description">{description}</p></slot>
        </div>
        <Image
          class="heading-illustration"
          src={image}
          alt={imageAlt}
          width={720}
          widths={[360, 720, 1080]}
          sizes="(max-width: 800px) calc(100vw - 3rem), 40vw"
          loading="eager"
        />
      </>
    ) : (
      <>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        <slot name="description"><p class="section-description">{description}</p></slot>
      </>
    )}
  </div>
</header>

<style>
  .page-heading :global(.container > p), .heading-copy :global(p) { max-width: 850px; margin-top: 1.4rem; color: var(--color-muted); font-size: var(--font-size-body); line-height: 1.9; }
  .heading-illustrated { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: center; gap: 3rem; }
  .heading-copy { min-width: 0; }
  .heading-illustration { width: 100%; height: auto; border-radius: 1rem; }
  @media (max-width: 800px) {
    .heading-illustrated { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  }
</style>
