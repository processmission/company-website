---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContentPlaceholder from '../components/ContentPlaceholder.astro';

const entry = (await getEntry('pages', 'resources'))!;
const page = entry.data;
const { Content: Introduction } = await render(entry);
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeading title={page.heading!}>
    <Introduction slot="description" />
  </PageHeading>
  {page.sections.map((section) => (
    <section class="section" aria-labelledby={section.id}>
      <div class="container">
        <div class="section-heading">
          <h2 id={section.id}>{section.title}</h2>
        </div>
        {section.items.map((item) => <ContentPlaceholder {...item} />)}
        {section.id === 'support' && <a class="text-link" href="/about/#contact">查看联系信息</a>}
      </div>
    </section>
  ))}
</BaseLayout>
