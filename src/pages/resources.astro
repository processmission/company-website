---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { withBase } from '../utils/paths';

const entry = (await getEntry('pages', 'resources'))!;
const page = entry.data;
const { Content: Introduction } = await render(entry);
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeading title={page.heading!} image={page.image} imageAlt={page.imageAlt}>
    <Introduction slot="description" />
  </PageHeading>
  <div class="container resource-directory">
    {page.sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        <div class="resource-description">
          <dl>
            {section.items.map((item) => (
              <div id={item.id}>
                <dt>{item.title}</dt>
                <dd>需要补充更多内容：{item.needed}。</dd>
              </div>
            ))}
          </dl>
          {section.id === 'support' && <a class="text-link" href={withBase('/about/#contact')}>查看联系信息</a>}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .resource-directory { padding-bottom: clamp(3.5rem, 7vw, 6.25rem); }
  .resource-directory section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1rem 3rem; padding-block: 1.5rem; border-top: 1px solid var(--color-border); }
  .resource-directory h2 { font-size: 1.35rem; scroll-margin-top: 1rem; }
  .resource-description { min-width: 0; }
  .resource-description dt { font-weight: 600; }
  .resource-description dd { margin: .35rem 0 0; color: var(--color-muted); font-size: 1rem; }
  .resource-description .text-link { margin-top: .75rem; }
  @media (max-width: 760px) {
    .resource-directory section { grid-template-columns: 1fr; }
  }
</style>
