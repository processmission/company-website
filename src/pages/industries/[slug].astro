---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'industries'>;
};

const { entry } = Astro.props;
const industry = entry.data;
const { Content } = await render(entry);
const relatedProducts = await getEntries(industry.recommendations.map(({ product }) => product));
---

<BaseLayout title={`${industry.title}解决方案｜进程使命`} description={industry.summary}>
  <PageHeading
    title={industry.heading}
    description={industry.summary}
    image={industry.image}
    imageAlt={industry.imageAlt}
  />
  <div class="container section industry-detail">
    <Content />

    <section class="detail-section" aria-labelledby="products-title">
      <h2 id="products-title">相关产品</h2>
      <p class="section-description">{industry.recommendationsDescription}</p>
      <ul class="detail-list related-products">
        {relatedProducts.map((product, index) => (
          <li>
            <h3><a class="text-link" href={withBase(`/products/${product.id}/`)}>{product.data.title}</a></h3>
            <p>{industry.recommendations[index].reason}</p>
          </li>
        ))}
      </ul>
    </section>

    <div><a class="button button-secondary" href={withBase('/industries/')}>返回行业方案总览</a></div>
  </div>
</BaseLayout>

<style>
  .industry-detail { gap: 2rem; }
  .industry-detail :global(.detail-runtime) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .industry-detail :global(.detail-runtime > div),
  .industry-detail :global(.detail-interface),
  .industry-detail :global(.detail-delivery > div) { padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; }
  .industry-detail :global(.detail-runtime > div:last-child) { grid-column: auto; }
  .industry-detail :global(.detail-hardware) { padding: 0; border: 0; }
  .industry-detail :global(.detail-interface) { margin-top: 1rem; }
  .industry-detail :global(.detail-boundary) { margin-top: 0; }
  .related-products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; margin-top: 1rem; padding: 0; list-style: none; }
  .related-products li + li { margin-top: 0; }
  .related-products h3 { font-size: 1rem; }
  .related-products .text-link { margin-top: 0; }
  @media (max-width: 600px) {
    .industry-detail :global(.detail-runtime), .related-products { grid-template-columns: 1fr; }
  }
</style>
