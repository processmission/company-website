---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContentPlaceholder from '../components/ContentPlaceholder.astro';
import { industries } from '../data/content';

const entry = (await getEntry('pages', 'industries'))!;
const page = entry.data;
const { Content: Scope } = await render(entry);
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <PageHeading
    eyebrow={page.eyebrow}
    title={page.heading!}
    description={page.description!}
  />
  <section class="section industries-section" aria-label="行业解决方案">
    <div class="container">
      <div class="industry-grid">
        {industries.map((industry) => (
          <article class="industry-card" aria-labelledby={`industry-title-${industry.slug}`}>
            <div class="industry-card-top"><span class="mono">{industry.label}</span></div>
            <h2 id={`industry-title-${industry.slug}`}><a class="industry-title-link" href={`/industries/${industry.slug}/`}>{industry.title}</a></h2>
            <p>{industry.description}</p>
            <div class="industry-interfaces">{industry.interfaces}</div>
            <a class="text-link" href={`/industries/${industry.slug}/`}>查看方案</a>
          </article>
        ))}
      </div>
      <Scope />
    </div>
  </section>
  <section class="section" aria-labelledby="cases">
    <div class="container">
      <div class="section-heading">
        <h2 id="cases">{page.sections[0].title}</h2>
      </div>
      <div class="product-grid">
        {page.sections[0].items.map((item) => <ContentPlaceholder {...item} />)}
      </div>
    </div>
  </section>
</BaseLayout>
