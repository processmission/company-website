---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContentPlaceholder from '../components/ContentPlaceholder.astro';
import { industries } from '../data/content';
import { withBase } from '../utils/paths';

const entry = (await getEntry('pages', 'industries'))!;
const page = entry.data;
const { Content: Scope } = await render(entry);
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <PageHeading
    eyebrow={page.eyebrow}
    title={page.heading!}
    description={page.description!}
  />
  <section class="section industries-section" aria-label="行业解决方案">
    <div class="container">
      <div class="industry-grid">
        {industries.map((industry) => (
          <article class="industry-card" aria-labelledby={`industry-title-${industry.slug}`}>
            <Image src={industry.image} alt={industry.imageAlt} width={720} widths={[360, 540, 720]} sizes="(max-width: 700px) calc(100vw - 2.5rem), (max-width: 1000px) 45vw, 560px" loading="lazy" />
            <div class="card-copy">
              <div class="industry-card-top"><span>{industry.label}</span></div>
              <h2 id={`industry-title-${industry.slug}`}><a class="industry-title-link" href={withBase(`/industries/${industry.slug}/`)}>{industry.title}</a></h2>
              <p>{industry.description}</p>
              <a class="text-link" href={withBase(`/industries/${industry.slug}/`)}>查看方案</a>
            </div>
          </article>
        ))}
      </div>
      <Scope />
    </div>
  </section>
  <section class="section" aria-labelledby="cases">
    <div class="container">
      <div class="section-heading">
        <h2 id="cases">{page.sections[0].title}</h2>
      </div>
      <div class="product-grid">
        {page.sections[0].items.map((item) => <ContentPlaceholder {...item} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .industry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .industry-card { padding: 0; background: white; }
  .industry-card:last-child { grid-column: auto; background: white; }
  .industry-card > img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .card-copy { padding: 1.5rem 1.75rem; }
  .industry-card-top { margin-bottom: .5rem; letter-spacing: normal; }
  .industry-card h2 { font-size: 1.5rem; }
  .industry-title-link { display: inline-flex; align-items: center; min-height: 44px; }
  .industry-title-link:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: .25rem; }
  .card-copy > p { margin-top: .65rem; color: var(--color-muted); font-size: 1rem; }
  .card-copy .text-link { margin-top: 1rem; }
  @media (max-width: 700px) {
    .industry-grid { grid-template-columns: 1fr; }
    .card-copy { padding: 1.25rem; }
    .industry-card h2 { font-size: 1.4rem; }
  }
</style>
