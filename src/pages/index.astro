---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, industries, productGroups, products } from '../data/content';
import { withBase } from '../utils/paths';

const entry = (await getEntry('pages', 'index'))!;
const page = entry.data;
const { Content: Hero } = await render(entry);
const architecture = (await getEntry('prose', 'home-architecture'))!;
const productIntroduction = (await getEntry('prose', 'home-products'))!;
const { Content: Architecture } = await render(architecture);
const { Content: ProductIntroduction } = await render(productIntroduction);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="hero-badge" href={withBase('/architecture/')}>
          <span class="badge-dot" aria-hidden="true"></span>
          {company.positioning}
          <span class="badge-separator" aria-hidden="true"></span>
          <span>{page.badge}</span>
        </a>
        <Hero />
        <div class="hero-actions">
          {page.actions.map((action, index) => (
            <a class={`button ${index === 0 ? 'button-primary' : 'button-secondary'}`} href={withBase(action.href)}>{action.label}</a>
          ))}
        </div>
      </div>
      <Image
        class="hero-image"
        src={page.image!}
        alt={page.imageAlt!}
        width={960}
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 800px) calc(100vw - 2.5rem), 52vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="industry-strip">
        <p>{page.industryIntro}</p>
        <nav aria-label="行业场景快捷导航">
          {industries.map((industry) => (
            <a href={withBase(`/industries/${industry.slug}/`)}>{industry.title}</a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="section architecture-section" aria-labelledby="architecture-overview-title">
    <div class="container">
      <div class="architecture-copy">
        <span class="eyebrow">{architecture.data.eyebrow}</span>
        <Architecture />
      </div>
    </div>
  </section>

  <section class="section products-section" aria-labelledby="products-overview-title">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">{productIntroduction.data.eyebrow}</span>
        <ProductIntroduction />
      </div>
      {productGroups.map((group) => (
        <section class="product-group" aria-labelledby={`overview-${group.id}`}>
          <h3 id={`overview-${group.id}`}><a href={withBase(`/products/#${group.id}`)}>{group.title}</a></h3>
          <div class="product-grid">
            {products.filter((product) => product.group === group.title).map((product) => (
              <article class="product-card overview-card" aria-labelledby={`overview-product-${product.slug}`}>
                <Image src={product.image} alt={product.imageAlt} width={720} widths={[360, 540, 720]} sizes="(max-width: 700px) calc(100vw - 2.5rem), (max-width: 1000px) 45vw, 560px" loading="lazy" />
                <div class="card-copy">
                  <div class="card-topline"><span>{product.category}</span></div>
                  <h4 id={`overview-product-${product.slug}`}><a class="product-title-link" href={withBase(`/products/${product.slug}/`)}>{product.title}</a></h4>
                  <p>{product.description}</p>
                  <a class="text-link" href={withBase(`/products/${product.slug}/`)}>查看产品</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: 64px 44px; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; text-align: left; }
  .hero-copy { min-width: 0; }
  .hero-copy :global(h1) { font-size: clamp(2.25rem, 3.7vw, 3.4rem); }
  .hero-badge { justify-content: flex-start; margin-bottom: 1.5rem; }
  .hero-actions { justify-content: flex-start; }
  .hero-image { width: 100%; border-radius: 1rem; }
  .industry-strip { grid-column: 1 / -1; margin-top: 1.5rem; padding-top: 1.75rem; border-top: 1px solid var(--color-border); }
  .industry-strip nav { justify-content: flex-start; gap: .5rem 2rem; }
  .architecture-section { padding-block: 64px; }
  .architecture-copy { max-width: 850px; }
  .architecture-copy :global(h2) { font-size: clamp(1.75rem, 2.7vw, 2.5rem); }
  .product-group + .product-group { margin-top: 3rem; }
  .product-group > h3 { margin-bottom: 1.5rem; font-size: 1.75rem; }
  .product-card { padding: 0; background: white; }
  .product-card::before { display: none; }
  .product-card > img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .card-copy { padding: 1.5rem 1.75rem; }
  .card-topline { margin-bottom: .5rem; }
  .product-card h4 { font-size: 1.5rem; font-weight: 600; letter-spacing: normal; }
  .card-copy > p { margin-top: .65rem; color: var(--color-muted); font-size: 1rem; }
  .product-title-link, .product-group > h3 a { display: inline-flex; align-items: center; min-height: 44px; }
  .product-title-link:hover, .product-group > h3 a:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: .25rem; }
  @media (max-width: 800px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .hero-copy { max-width: 650px; }
    .hero-image { width: min(100%, 650px); justify-self: center; }
    .industry-strip { margin-top: 0; }
  }
  @media (max-width: 700px) {
    .hero { padding-block: 40px 36px; }
    .hero-copy :global(h1) { font-size: clamp(1.75rem, 6.8vw, 2.5rem); }
    .hero-actions { gap: .6rem; }
    .hero-actions .button { padding-inline: 1rem; }
    .industry-strip nav { gap: 0 1rem; }
    .product-grid { grid-template-columns: 1fr; }
    .card-copy { padding: 1.25rem; }
    .product-card h4 { font-size: 1.4rem; }
    .architecture-section { padding-block: 48px; }
  }
</style>
