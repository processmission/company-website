---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContentPlaceholder from '../components/ContentPlaceholder.astro';
import { company, contactItems, officialChannels } from '../data/content';

const entry = (await getEntry('pages', 'about'))!;
const page = entry.data;
const { Content: CompanyStory } = await render(entry);
---

<BaseLayout title={`关于我们｜${company.shortName}`} description={company.description}>
  <PageHeading eyebrow={page.eyebrow} title={page.heading!} description={company.positioning} />
  <section class="section about-section" aria-labelledby="about-title">
    <div class="container about-grid">
      <div>
        <h2 id="about-title">{company.mission}</h2>
      </div>
      <div class="about-copy">
        <p class="company-name">{company.name}</p>
        <p>{company.description}</p>
        <CompanyStory />
      </div>
    </div>
  </section>
  {page.sections.map((section) => (
    <section id={section.id} class="section company-information" aria-labelledby={`${section.id}-title`}>
      <div class="container">
        <div class="section-heading">
          <h2 id={`${section.id}-title`}>{section.title}</h2>
        </div>
        {section.id === 'contact' ? (
          <div class="product-grid">{contactItems.map((item) => <ContentPlaceholder {...item} />)}</div>
        ) : section.id === 'channels' ? (
          <div class="product-grid">{officialChannels.map((channel) => <ContentPlaceholder {...channel} />)}</div>
        ) : section.items.map((item) => <ContentPlaceholder {...item} />)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .company-information { padding-block: clamp(2rem, 5vw, 4rem); scroll-margin-top: 1rem; }
</style>
