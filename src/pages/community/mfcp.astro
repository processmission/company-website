---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { withBase } from '../../utils/paths';

const entry = (await getEntry('pages', 'mfcp'))!;
const page = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeading title={page.heading!} description={page.description} />
  <div class="container section mfcp-detail">
    <Content />
    <div><a class="button button-secondary" href={withBase('/community/')}>返回开源社区</a></div>
  </div>
</BaseLayout>

<style>
  .mfcp-detail { display: grid; gap: 3.5rem; padding-block: 3rem 4rem; color: var(--color-muted); }
  .mfcp-detail :global(h2) { margin-bottom: 1.5rem; color: var(--color-text); font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .mfcp-detail :global(a) { display: inline-flex; align-items: center; min-height: 44px; max-width: 100%; color: var(--color-blue); text-decoration: underline; text-underline-offset: .25rem; }
  .mfcp-detail :global(a:hover) { color: var(--color-accent); }
  .mfcp-detail :global(.mfcp-projects) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .mfcp-detail :global(.mfcp-project) { min-width: 0; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: .9rem; background: var(--color-bg); box-shadow: var(--shadow-panel); }
  .mfcp-detail :global(.mfcp-project img) { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; }
  .mfcp-detail :global(.mfcp-project h3) { margin-top: .75rem; font-size: 1.35rem; }
  .mfcp-detail :global(.mfcp-project h3 a) { text-decoration: none; }
  .mfcp-detail :global(.mfcp-project h3 a:hover) { text-decoration: underline; }
  .mfcp-detail :global(.mfcp-project h3 + p) { margin-top: .25rem; font-size: 1rem; }
  .mfcp-detail :global(.mfcp-process ol) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin: 0; padding: 1.5rem; border-block: 1px solid var(--color-border); background: var(--color-surface); list-style-position: inside; }
  .mfcp-detail :global(.mfcp-process li) { min-width: 0; font-size: 1rem; }
  .mfcp-detail :global(.mfcp-process li::marker) { color: var(--color-accent); font-weight: 600; }
  .mfcp-detail :global(.mfcp-process strong) { color: var(--color-text); }
  .mfcp-detail :global(.mfcp-entries ul) { display: flex; flex-wrap: wrap; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .mfcp-detail :global(.mfcp-entries li a) { padding: .5rem 1rem; border: 1px solid var(--color-border); border-radius: .55rem; background: var(--color-bg); font-size: 1rem; font-weight: 600; text-decoration: none; }
  .mfcp-detail :global(.mfcp-entries li a:hover) { border-color: var(--color-blue); background: var(--color-blue-soft); }
  .mfcp-detail :global(.mfcp-status) { margin-top: 1rem; font-size: 1rem; }
  .mfcp-detail :global(.mfcp-credit) { font-size: var(--font-size-small); }
  .mfcp-detail .button { text-decoration: none; }

  @media (max-width: 760px) {
    .mfcp-detail { gap: 2.5rem; padding-block: 2rem 3rem; }
    .mfcp-detail :global(.mfcp-projects) { grid-template-columns: minmax(0, 1fr); }
    .mfcp-detail :global(.mfcp-process ol) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .mfcp-detail :global(.mfcp-project) { padding: 1rem; }
    .mfcp-detail :global(.mfcp-process ol) { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  }
</style>
