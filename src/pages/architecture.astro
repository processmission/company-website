---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import SystemDiagram from '../components/SystemDiagram.astro';

const entry = (await getEntry('pages', 'architecture'))!;
const page = entry.data;
const { Content: Chapters } = await render(entry);
const { Content: Introduction } = await render((await getEntry('prose', 'architecture-intro'))!);
const { Content: Overview } = await render((await getEntry('prose', 'architecture-overview'))!);
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeading eyebrow={page.eyebrow} title={page.heading!}>
    <Introduction slot="description" />
  </PageHeading>
  <section class="section architecture-section" aria-labelledby="architecture-title">
    <div class="container split-layout">
      <div class="architecture-copy">
        <Overview />
      </div>
      <SystemDiagram />
    </div>
  </section>
  <div class="container section industry-detail architecture-chapters">
    <Chapters />
  </div>
</BaseLayout>

<style>
  .architecture-chapters :global(.detail-section) { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; scroll-margin-top: 2rem; }
  .architecture-chapters :global(.chapter-visual) { min-width: 0; }
  .architecture-chapters :global(.chapter-visual p) { margin: 0; }
  .architecture-chapters :global(.chapter-visual img) { display: block; width: 100%; height: auto; border-radius: .75rem; }
  .architecture-chapters :global(.chapter-copy > h2) { margin-bottom: 1.25rem; font-size: 1.5rem; letter-spacing: normal; }
  .architecture-chapters :global(.chapter-copy > p:not(.detail-boundary)) { color: var(--color-muted); }
  .architecture-chapters :global(.chapter-copy > ul) { margin: 1.25rem 0 0; padding-left: 1.25rem; color: var(--color-muted); }
  .architecture-chapters :global(.chapter-copy > ul li + li) { margin-top: .6rem; }
  .architecture-chapters :global(.chapter-links) { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .architecture-chapters :global(.illustration-source) { margin-top: 2rem; font-size: .875rem; color: var(--color-muted); }
  @media (max-width: 800px) {
    .architecture-section :global(.system-diagram) { order: -1; }
  }
  @media (max-width: 760px) {
    .architecture-chapters :global(.detail-section) { grid-template-columns: 1fr; }
    .architecture-chapters :global(.chapter-visual) { max-width: 32rem; margin-inline: auto; }
  }
</style>
