---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { engineeringStages, productGroups, products } from '../data/content';

const entry = (await getEntry('pages', 'products'))!;
const page = entry.data;
const { Content: EngineeringIntroduction } = await render(entry);
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <PageHeading
    eyebrow={page.eyebrow}
    title={page.heading!}
    description={page.description!}
  />
  <section class="section products-section" aria-label="产品与平台">
    <div class="container">
      {productGroups.map((group) => (
        <section id={group.id} class="product-group" aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <div class="product-grid">
            {products.filter((product) => product.group === group.title).map((product) => (
              <article class="product-card" aria-labelledby={`product-${product.slug}`}>
                <div class="card-topline"><span>{product.category}</span></div>
                <h3 id={`product-${product.slug}`}><a class="product-title-link" href={`/products/${product.slug}/`}>{product.title}</a></h3>
                <p>{product.description}</p>
                <ul class="feature-list">
                  {product.features.map((feature) => <li>{feature}</li>)}
                </ul>
                <a class="text-link" href={`/products/${product.slug}/`}>查看产品</a>
              </article>
            ))}
          </div>
        </section>
      ))}
      <section id="engineering" class="engineering-panel" aria-labelledby="engineering-title">
        <div class="engineering-heading">
          <EngineeringIntroduction />
        </div>
        <ol class="engineering-stages">
          {engineeringStages.map((stage) => (
            <li><span class="mono">{stage.number}</span><h3>{stage.title}</h3><p>{stage.description}</p></li>
          ))}
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .product-group + .product-group { margin-top: 3rem; }
  .product-group > h2 { margin-bottom: 1.5rem; font-size: 1.75rem; }
  .product-title-link { display: inline-flex; align-items: center; min-height: 44px; }
  .product-title-link:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: .25rem; }
</style>
