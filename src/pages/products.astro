---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { engineeringStages, productGroups, products } from '../data/content';
import { withBase } from '../utils/paths';

const entry = (await getEntry('pages', 'products'))!;
const page = entry.data;
const { Content: EngineeringIntroduction } = await render(entry);
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <PageHeading
    eyebrow={page.eyebrow}
    title={page.heading!}
    description={page.description!}
  />
  <section class="section products-section" aria-label="产品与平台">
    <div class="container">
      {productGroups.map((group) => (
        <section id={group.id} class="product-group" aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <div class="product-grid">
            {products.filter((product) => product.group === group.title).map((product) => (
              <article class="product-card" aria-labelledby={`product-${product.slug}`}>
                <Image src={product.image} alt={product.imageAlt} width={720} widths={[360, 540, 720]} sizes="(max-width: 700px) calc(100vw - 2.5rem), (max-width: 1000px) 45vw, 560px" loading="lazy" />
                <div class="card-copy">
                  <div class="card-topline"><span>{product.category}</span></div>
                  <h3 id={`product-${product.slug}`}><a class="product-title-link" href={withBase(`/products/${product.slug}/`)}>{product.title}</a></h3>
                  <p>{product.description}</p>
                  <a class="text-link" href={withBase(`/products/${product.slug}/`)}>查看产品</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
      <section id="engineering" class="engineering-panel" aria-labelledby="engineering-title">
        <div class="engineering-heading">
          <EngineeringIntroduction />
        </div>
        <ol class="engineering-stages">
          {engineeringStages.map((stage) => (
            <li><span class="mono">{stage.number}</span><h3>{stage.title}</h3><p>{stage.description}</p></li>
          ))}
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .product-group + .product-group { margin-top: 3rem; }
  .product-group > h2 { margin-bottom: 1.5rem; font-size: 1.75rem; }
  .product-card { padding: 0; background: white; }
  .product-card::before { display: none; }
  .product-card > img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .card-copy { padding: 1.5rem 1.75rem; }
  .card-topline { margin-bottom: .5rem; }
  .card-copy > p { margin-top: .65rem; color: var(--color-muted); font-size: 1rem; }
  .card-copy .text-link { margin-top: 1rem; }
  .product-title-link { display: inline-flex; align-items: center; min-height: 44px; }
  .product-title-link:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: .25rem; }
  @media (max-width: 700px) {
    .product-grid { grid-template-columns: 1fr; }
    .card-copy { padding: 1.25rem; }
  }
</style>
