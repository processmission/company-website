---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { community } from '../data/content';
import { withBase } from '../utils/paths';

const entry = (await getEntry('pages', 'community'))!;
const page = entry.data;
const { Content: Introduction } = await render(entry);
const mfcp = (await getEntry('pages', 'mfcp'))!;
---

<BaseLayout title={`开源社区 · ${community.name}｜进程使命`} description={community.description}>
  <PageHeading eyebrow={community.name} title={page.heading!} description={community.positioning} image={page.image} imageAlt={page.imageAlt} />
  <section class="section community-section" aria-labelledby="community-title">
    <div class="container community-introduction">
      <div class="community-copy">
        <Introduction />
        <p>{community.description}</p>
      </div>
      <section class="mfcp-entry" aria-labelledby="mfcp-title">
        <h2 id="mfcp-title">{mfcp.data.heading}</h2>
        <p>{mfcp.data.description}</p>
        <a class="text-link" href={withBase('/community/mfcp/')}>了解 MFCP</a>
      </section>
    </div>
  </section>
  <div class="container community-directory">
    {page.sections.map((section) => (
      <section id={section.id} aria-labelledby={`${section.id}-title`}>
        <h2 id={`${section.id}-title`}>{section.title}</h2>
        <dl>
          {section.items.map((item) => (
            <div id={item.id}>
              <dt>{item.title}</dt>
              <dd>需要补充更多内容：{item.needed}。</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .community-introduction { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .community-copy > p { margin-top: 1.25rem; color: var(--color-muted); }
  .mfcp-entry { padding-left: 2rem; border-left: 2px solid var(--color-accent); }
  .mfcp-entry h2 { font-size: 1.5rem; }
  .mfcp-entry p { margin-top: .75rem; color: var(--color-muted); }
  .community-directory { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 4rem; padding-bottom: clamp(3.5rem, 7vw, 6.25rem); }
  .community-directory section { padding-top: 1.25rem; border-top: 1px solid var(--color-border); scroll-margin-top: 1rem; }
  .community-directory h2 { font-size: 1.35rem; }
  .community-directory dl { margin-top: .75rem; }
  .community-directory dt { font-weight: 600; }
  .community-directory dd { margin: .35rem 0 0; color: var(--color-muted); font-size: 1rem; }
  @media (max-width: 760px) {
    .community-introduction, .community-directory { grid-template-columns: 1fr; }
    .mfcp-entry { padding-left: 1.25rem; }
  }
</style>
